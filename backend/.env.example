# PisosRealView Backend — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# Servidor
PORT=3001
NODE_ENV=development

# CORS — origem permitida para o frontend
CORS_ORIGIN=http://localhost:5173

# WaveSpeedAI — provedor principal de simulação (obrigatório)
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Pika Labs — free tier 80 simulações/mês (opcional)
PIKA_API_KEY=

# Zhipu CogView — free tier (opcional)
ZHIPU_API_KEY=
ZHIPU_FREE_CREDITS_LIMIT=0

# CometAPI — fallback pago (opcional)
COMET_API_KEY=

# Limites de crédito free tier
PIKA_FREE_CREDITS_LIMIT=80

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Payload máximo
MAX_PAYLOAD_SIZE=10mb

# Admin — token para endpoints /admin/* (obrigatório em produção)
ADMIN_SECRET=change_me_in_production

# Redis Upstash — para CreditTracker em produção (opcional no MVP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging
LOG_LEVEL=info

# Timeout do provider em ms (padrão: 45000)
PROVIDER_TIMEOUT_MS=45000

# Asaas — gateway de pagamento
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
